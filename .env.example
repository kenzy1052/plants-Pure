# Plants & Pure — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. Values below are placeholders; the app treats
# placeholders as "not configured". See docs/ENVIRONMENT.md.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paystack (Settings → API Keys & Webhooks). Use TEST keys until go-live. -
# SERVER ONLY. sk_test_… for development; sk_live_… only in production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Cloudinary (Dashboard → API Keys) ---------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# SERVER ONLY.
CLOUDINARY_API_SECRET=your-api-secret

# --- Resend ------------------------------------------------------------------
# SERVER ONLY.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend (account-owner task).
RESEND_FROM_EMAIL=Plants & Pure <orders@your-verified-domain.example>

# live    = send to real customers (default in production)
# sandbox = send ONLY to EMAIL_SANDBOX_RECIPIENT (default outside production)
# off     = send nothing
EMAIL_MODE=sandbox
EMAIL_SANDBOX_RECIPIENT=you@example.com

# --- Operations --------------------------------------------------------------
# Optional. Enables detailed (still secret-free) output on GET /api/health when
# sent as "Authorization: Bearer <token>".
HEALTH_CHECK_TOKEN=
